+// Security patch (UseClevr): CVE-2026-112366 / GHSA-fc5q-39xc-vjpf.
+// A single branch made of literals and single stars (no globstar, path
+// separators, quoting, escapes or other glob/regex syntax) is absorbed by its
+// own star, so the outer unbounded quantifier is redundant and only enables
+// catastrophic backtracking. Mirrors upstream micromatch/picomatch#237/#246.
+const isSelfRepeatingStarBranch = branch => {
+  return branch.includes('*') &&
