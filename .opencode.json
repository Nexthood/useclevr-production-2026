{
  "$schema": "https://opencode.ai/config.json",
  "max_output_lines": 60,
  "verbose": false,
  "show_api_results": false,
  "show_api_requests": false,
  "collapse_thinking": true,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:3b": {
          "name": "Qwen 2.5 Coder 3B"
        },
        "phi3:mini": {
          "name": "Phi-3 Mini"
        }
      }
    }
  },
  "model": "ollama/phi3:mini",
  "small_model": "ollama/phi3:mini",
  "lsp": {
    "eslint": {
      "command": [
        "node_modules/.bin/vscode-eslint-language-server"
      ],
      "extensions": [
        "js",
        "jsx",
        "ts",
        "tsx",
        "mjs",
        "cjs"
      ]
    },
    "tailwindcss": {
      "command": [
        "node_modules/.bin/tailwindcss-language-server"
      ],
      "extensions": [
        "css",
        "tsx",
        "jsx"
      ]
    }
  },
  "mcp": {
    "mcp_everything": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-everything"],
      "enabled": true
    }
  },
  "formatter": true,
  "instructions": [
    "AGENTS.md"
  ]
}
