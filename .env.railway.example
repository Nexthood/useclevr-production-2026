# UseClevr Environment Variables for Railway
# Required for Production Deployment

# ===========================================
# DATABASE (Required)
# ===========================================
# Neon PostgreSQL connection string (get from Neon dashboard)
# Always use sslmode=verify-full — it is the canonical secure mode; 'require' is a deprecated alias.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=verify-full&channel_binding=require
# Or for direct connection (bypasses pooler)
DIRECT_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=verify-full&channel_binding=require

# ===========================================
# AUTH (Required for NextAuth v5)
# ===========================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-generated-secret-min-32-chars-here

# Railway provides PORT at runtime. Do not set PORT manually unless needed.
# Auth.js can infer the public host from Railway proxy headers because the app sets trustHost.
# Optional override only for custom domains or unusual proxy setups:
# AUTH_URL=https://test.useclevr.com
# NEXTAUTH_URL=https://test.useclevr.com
# NEXT_PUBLIC_APP_URL=https://test.useclevr.com

# ===========================================
# AI PROVIDER (Required)
# ===========================================
# Gemini is the active cloud AI provider.
GEMINI_API_KEY=AIza...  # Get from https://aistudio.google.com/app/apikey

# ===========================================
# STRIPE (Optional — billing & subscriptions)
# ===========================================
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from your Stripe products (leave blank if billing is disabled)
USECLEVR_PRO_PRICE_EUR=price_...
USECLEVR_PRO_PRICE_GBP=price_...
USECLEVR_PRO_PRICE_USD=price_...
USECLEVR_PRO_PRICE_CAD=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_BUSINESS_PRICE_ID_EUR=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# Business non-EUR markets stay unavailable until approved prices and matching Stripe Price IDs exist.
# STRIPE_BUSINESS_PRICE_ID_GBP=price_...
# STRIPE_BUSINESS_PRICE_ID_USD=price_...
# STRIPE_BUSINESS_PRICE_ID_CAD=price_...

# ===========================================
# SQUARE RETAIL POS (Optional)
# ===========================================
SQUARE_APPLICATION_ID=sandbox-sq0idb-...
SQUARE_APPLICATION_SECRET=sandbox-sq0csp-...
SQUARE_ENVIRONMENT=sandbox
SQUARE_REDIRECT_URI=https://test.useclevr.com/api/integrations/retail/square/callback
SQUARE_WEBHOOK_NOTIFICATION_URL=https://test.useclevr.com/api/integrations/retail/square/webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=...

# Production uses its separate Square production application and exact callback:
# SQUARE_ENVIRONMENT=production
# SQUARE_APPLICATION_ID=sq0idp-...
# SQUARE_APPLICATION_SECRET=sq0csp-...
# SQUARE_REDIRECT_URI=https://app.useclevr.com/api/integrations/retail/square/callback
RETAIL_TOKEN_ENCRYPTION_KEY=your-generated-retail-token-key-min-32-chars

# ClevrSync Google Sheets (Optional)
GOOGLE_CLEVRSYNC_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLEVRSYNC_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CLEVRSYNC_REDIRECT_URI=https://app.useclevr.com/api/clevrsync/google/oauth/callback
CLEVRSYNC_TOKEN_ENCRYPTION_KEY=your-generated-token-encryption-key-min-32-chars

# ===========================================
# UPLOAD STORAGE (Optional - defaults to local)
# ===========================================
# Local storage (default - uploads stored in container)
LOCAL_UPLOAD_DIR=/tmp/useclevr-uploads
LOCAL_UPLOAD_URL=/uploads

# Or S3/R2 (uncomment and configure):
# UPLOAD_PROVIDER=s3  # or 'r2'
# AWS_S3_BUCKET=useclevr-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# R2 (Cloudflare):
# UPLOAD_PROVIDER=r2
# R2_BUCKET=useclevr-uploads
# R2_ENDPOINT=https://...
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...

# ===========================================
# OPTIONAL FEATURES
# ===========================================
# Demo mode (skip auth, use mock data)
# DEMO_MODE=true

# ===========================================
# REVERSE PROXY (Railway specific)
# ===========================================
# Trust Railway's reverse proxy headers
TRUST_PROXY=true

# For secure headers validation
# X_FORWARDED_PROTO=https
# X_FORWARDED_HOST=your-app.railway.app

# ===========================================
# SUPERADMIN FALLBACK (Required for production)
# ===========================================
# When email verification delivery fails, the configured superadmin email can
# authenticate via a secure fallback code instead of the emailed 6-digit code.
# Set ADMIN_AUTH_BYPASS_ENABLED=true and ADMIN_AUTH_BYPASS_EMAIL to the
# superadmin email address. The fallback code is a server-side secret generated
# with `openssl rand -hex 16` (or similar) and never sent to users.
ADMIN_AUTH_BYPASS_ENABLED=true
ADMIN_AUTH_BYPASS_EMAIL=superadmin@useclevr.com
ADMIN_AUTH_BYPASS_CODE=

# ===========================================
# USY CONTACT HANDOFF (Required for the Usy contact flow)
# ===========================================
# Without both values the contact endpoint returns 503 and Usy reports the
# contact handoff as not configured. The URL is the central n8n inbound
# webhook URL and the secret is the bearer token n8n validates; both stay
# server-side only and are never exposed to the browser. Generate the secret
# with `openssl rand -hex 32` and configure the same value in the n8n
# workflow. The n8n workflow routes the confirmed payload's category
# (sales, technical_support, billing, management, executive) to the matching
# destination mailbox, with support@useclevr.com as the Technical Support / IT
# destination. Do not fabricate placeholder values in production.
USY_CONTACT_N8N_WEBHOOK_URL=
USY_CONTACT_N8N_WEBHOOK_SECRET=

# ===========================================
# ANALYTICS (Optional)
# ===========================================
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=...
