{
  "name": "useclevr-2026",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0+sha512.dbfcc4f81cf48597afd4bc391ffdf12c11f1a9fb83a395bfa6b0a2d9cc2fd8ffebafdb1ccbd529632153f793904c2615b7f09fe1a345473fd1c35845172a8eb1",
  "homepage": "https://useclevr.com",
  "keywords": [
    "business-intelligence",
    "analytics",
    "csv",
    "ai",
    "nextjs"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "AUTH_TRUST_HOST=true next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "dev:all": "pnpm dev",
    "dev:frontend": "pnpm dev",
    "dev:server": "pnpm dev",
    "build": "next build --webpack",
    "build:clean": "pnpm clean:generated",
    "build:next": "pnpm build",
    "build:preview": "pnpm prod:build && pnpm start:dist",
    "start": "pnpm prod:start",
    "start:next": "next start --hostname 0.0.0.0 --port ${PORT:-8080}",
    "prod:install": "corepack enable && corepack prepare pnpm@11.5.0 --activate && pnpm install --frozen-lockfile",
    "prod:build": "node ./scripts/package-dist/clean-generated.cjs --prod && NEXT_TELEMETRY_DISABLED=1 pnpm build && node ./scripts/package-dist/create-dist.cjs",
    "build:prod": "pnpm prod:build",
    "prod:start": "pnpm start:dist",
    "prod:local": "USECLEVR_SERVER_TARGET=local node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "prod:railway": "USECLEVR_SERVER_TARGET=railway node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "prod:vercel": "USECLEVR_SERVER_TARGET=vercel node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "prod": "pnpm prod:build && echo '✅ Dist is ready! Run \"pnpm start:dist\" to start the server.'",
    "start:dist": "pnpm prod:local",
    "preview": "pnpm build:preview",
    "railway:login": "railway login --browserless",
    "railway:link": "railway link",
    "railway:status": "railway status",
    "railway:logs": "railway logs",
    "deploy:railway:sync": "node ./scripts/server/railway/sync-config.cjs --check",
    "deploy:railway:check": "node ./scripts/server/railway/sync-config.cjs --check",
    "deploy:vercel:sync": "node ./scripts/server/vercel/sync-config.cjs",
    "deploy:vercel:check": "node ./scripts/server/vercel/sync-config.cjs --check",
    "ci:railway": "pnpm deploy:railway:sync",
    "ci:validate": "CI=true pnpm validate:types && CI=true pnpm validate:dist && CI=true pnpm lint:package && CI=true pnpm test:all && CI=true DATABASE_URL=postgresql://ci:ci@localhost:5432/ci pnpm build",
    "validate": "pnpm validate:types && pnpm validate:dist && pnpm validate:release",
    "validate:precommit": "pnpm lint:package && pnpm lint:todos && pnpm lint:workflows && pnpm lint:staged",
    "validate:types": "tsc --noEmit --pretty false",
    "validate:build": "pnpm build",
    "validate:publish": "pnpm prod:build",
    "validate:dist": "pnpm deploy:railway:check && pnpm deploy:vercel:check",
    "validate:release": "node ./scripts/release/check.cjs",
    "analyze:business": "node -r tsx/esm scripts/analysis/analyze-business.ts",
    "test:all": "pnpm test:csv-analyzer && pnpm test:csv-edge-cases",
    "test:csv-analyzer": "node -r tsx/esm scripts/analysis/test-csv-analyzer.ts",
    "test:csv-edge-cases": "node -r tsx/esm scripts/analysis/test-csv-edge-cases.ts",
    "test:neon": "bash scripts/health/test-neon-connection.sh",
    "test": "pnpm test:all",
    "clean:dev": "node ./scripts/package-dist/clean-generated.cjs",
    "clean:prod": "node ./scripts/package-dist/clean-generated.cjs --prod",
    "clean:generated": "node ./scripts/package-dist/clean-generated.cjs --generated",
    "clean:all": "node ./scripts/package-dist/clean-generated.cjs --all",
    "clean": "pnpm clean:all && rm -rf dist .next",
    "lint": "pnpm lint:package && pnpm lint:todos && pnpm lint:workflows && node ./scripts/validate-pricing.js && node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.mjs",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --fix",
    "lint:staged": "lint-staged",
    "lint:all": "pnpm lint && pnpm lint:deps",
    "lint:changelog": "node ./scripts/check-unreleased.js && node ./scripts/check-changelog.js",
    "lint:commits": "node ./node_modules/@commitlint/cli/cli.js --from HEAD~10 --to HEAD --verbose",
    "lint:deps": "node ./scripts/check-latest-deps.js",
    "lint:docs": "markdownlint --config .markdownlint.json \"docs/**/*.md\" \"README.md\" \"CHANGELOG.md\" \"*.md\"",
    "lint:package": "node ./scripts/check-package-json.js",
    "lint:todos": "node ./scripts/check-todo-management.js",
    "lint:workflows": "node ./scripts/check-github-workflows.js",
    "lint:workflows:fix": "node ./scripts/check-github-workflows.js --fix",
    "link:docs": "node ./scripts/check-docs-links.js",
    "format": "prettier --write \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\" \".TODO/**/*.md\"",
    "format:check": "prettier --check \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\" \".TODO/**/*.md\"",
    "docs:check": "pnpm link:docs",
    "docs:lint": "pnpm lint:docs",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:ci": "pnpm audit --audit-level=moderate --json",
    "deps:check": "pnpm outdated",
    "health": "pnpm validate && pnpm test:all && pnpm docs:check && pnpm audit",
    "release:check": "pnpm validate && pnpm lint:changelog",
    "release:tag": "node ./scripts/release/tag.cjs",
    "release": "pnpm release:check && pnpm release:tag && pnpm prod:build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@aws-sdk/client-s3": "^3.1056.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/papaparse": "^5.5.2",
    "ai": "^6.0.192",
    "bcryptjs": "^3.0.3",
    "canvg": "3.0.11",
    "clsx": "2.1.1",
    "dompurify": "3.4.1",
    "drizzle-orm": "^0.45.2",
    "html2canvas": "1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.17.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "postcss-import": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "recharts": "^3.8.1",
    "stripe": "^14.25.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@tailwindcss/language-server": "^0.14.29",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "autoprefixer": "10.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.4.0",
    "eslint-plugin-only-warn": "^1.2.1",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "lint-staged": "^17.0.7",
    "markdownlint-cli": "^0.48.0",
    "postcss": "8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.22.3",
    "turbo": "^2.9.16",
    "typescript": "6.0.3",
    "vscode-langservers-extracted": "^4.10.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "node ./node_modules/eslint/bin/eslint.js --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=26.1.0"
  },
  "enginesStrict": true
}
