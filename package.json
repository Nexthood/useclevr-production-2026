    "business-intelligence",
    "analytics",
    "csv",
    "ai",
    "nextjs"
  ],
  "scripts": {
    "prepare": "husky",
    "dev": "AUTH_TRUST_HOST=true next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "build": "next build --webpack",
    "prod:build": "node ./scripts/package-dist/clean-generated.cjs --prod && NEXT_TELEMETRY_DISABLED=1 pnpm build && node ./scripts/package-dist/create-dist.cjs",
    "start": "USECLEVR_SERVER_TARGET=local node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "preview": "pnpm prod:build && pnpm start",
    "prod:install": "corepack enable && corepack prepare pnpm@11.5.0 --activate && pnpm install --frozen-lockfile",
    "prod:railway": "USECLEVR_SERVER_TARGET=railway node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "prod:vercel": "USECLEVR_SERVER_TARGET=vercel node -r ./scripts/runtime/load-env.cjs ./scripts/runtime/start-dist.cjs",
    "railway": "node ./scripts/server/railway/railway.cjs",
    "railway:login": "node ./scripts/server/railway/railway.cjs login",
    "railway:link": "node ./scripts/server/railway/railway.cjs link",
    "railway:list": "node ./scripts/server/railway/railway.cjs list",
    "railway:status": "node ./scripts/server/railway/railway.cjs status",
    "railway:logs": "node ./scripts/server/railway/railway.cjs logs",
    "railway:cleanup": "node ./scripts/server/railway/railway.cjs cleanup",
    "deploy:railway:sync": "node ./scripts/server/railway/sync-config.cjs --check",
    "deploy:railway:check": "node ./scripts/server/railway/sync-config.cjs --check",
    "deploy:vercel:sync": "node ./scripts/server/vercel/sync-config.cjs",
    "deploy:vercel:check": "node ./scripts/server/vercel/sync-config.cjs --check",
    "ci:railway": "pnpm deploy:railway:sync",
    "ci:validate": "CI=true pnpm validate:types && CI=true pnpm validate:dist && CI=true pnpm lint:package && CI=true pnpm test:all && CI=true DATABASE_URL=postgresql://ci:ci@localhost:5432/ci pnpm build",
    "validate": "pnpm validate:types && pnpm validate:dist && pnpm validate:release",
    "validate:precommit": "pnpm lint:project-records && pnpm lint:todos && pnpm lint:changelog && pnpm lint:secrets && pnpm lint:package",
    "validate:prepush": "pnpm validate:types && pnpm validate:dist && pnpm lint && pnpm validate:publish",
    "validate:types": "tsc --noEmit --pretty false",
    "validate:build": "pnpm build",
    "validate:publish": "pnpm prod:build",
    "validate:dist": "pnpm deploy:railway:check && pnpm deploy:vercel:check",
    "validate:release": "node ./scripts/release/check.cjs",
    "analyze:business": "node -r tsx/esm scripts/analysis/analyze-business.ts",
    "test:all": "pnpm test:auth && pnpm test:csv-analyzer && pnpm test:csv-edge-cases && pnpm test:hybrid-ai-gates && pnpm test:business-intelligence && pnpm test:risk-intelligence",
    "test:auth-flow": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/auth/test-email-password-auth-flow.ts",
    "test:auth": "node -r tsx/esm scripts/auth/test-auth-redirect.ts",
    "test:csv-analyzer": "node -r tsx/esm scripts/analysis/test-csv-analyzer.ts",
    "test:csv-edge-cases": "node -r tsx/esm scripts/analysis/test-csv-edge-cases.ts",
    "test:bbsc": "node -r tsx/esm scripts/analysis/test-bbsc.ts",
    "test:profitability-two-file": "node -r tsx/esm scripts/analysis/test-profitability-two-file.ts",
    "test:business-intelligence": "node -r tsx/esm scripts/analysis/test-business-intelligence-engine.ts",
    "test:dataset-intelligence-engine": "node -r tsx/esm scripts/analysis/test-dataset-intelligence-engine.ts",
    "test:edie-pipeline": "node -r tsx/esm scripts/analysis/test-edie-pipeline.ts",
    "test:edie-structure-scanner": "node -r tsx/esm scripts/analysis/test-edie-structure-scanner.ts",
    "test:edie-semantic-scanner": "node -r tsx/esm scripts/analysis/test-edie-semantic-scanner.ts",
    "test:segment-decline-analysis": "node -r tsx/esm scripts/analysis/test-segment-decline-analysis.ts",
    "test:segment-decline-presentation": "node -r tsx/esm scripts/analysis/test-segment-decline-presentation.ts",
    "test:analytical-intents": "node -r tsx/esm scripts/analysis/test-analytical-intents.ts",
    "test:dataset-ai-assistant": "node -r tsx/esm scripts/analysis/test-dataset-ai-assistant.ts",
    "test:business-profile-ssot": "node -r tsx/esm scripts/business/test-business-profile-ssot.ts",
    "test:risk-intelligence": "node -r tsx/esm scripts/risk-intelligence/test-risk-engine.ts",
    "test:standard-upload-success-ui": "node -r tsx/esm scripts/upload/test-standard-upload-success-ui.ts",
    "test:accuracy-tenant-isolation": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/accuracy/test-tenant-isolation.ts",
    "test:hybrid-ai-gates": "node -r tsx/esm scripts/hybrid-ai/test-feature-gates.ts",
    "test:ai-provider-security": "node -r tsx/esm scripts/ai/test-provider-security.ts",
    "test:dashboard-crud": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/health/test-dashboard-crud.ts",
    "test:dataset-deletion": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/health/test-dataset-deletion.ts",
    "test:credit-engine": "node -r tsx/esm scripts/billing/test-credit-engine.ts",
    "test:retail-pos": "node -r tsx/esm scripts/retail/test-pos-integration.ts",
    "test:pro-pricing": "node -r tsx/esm scripts/billing/test-pro-launch-pricing.ts",
    "test:mcp-dashboard": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/health/test-payload-mcp-dashboard.ts",
    "test:neon": "bash scripts/health/test-neon-connection.sh",
    "test:resend-verification": "node -r ./scripts/runtime/load-env.cjs -r tsx/esm scripts/health/test-resend-verification-email.ts",
    "test": "pnpm test:all",
    "clean:dev": "node ./scripts/package-dist/clean-generated.cjs",
    "clean:prod": "node ./scripts/package-dist/clean-generated.cjs --prod",
    "clean:generated": "node ./scripts/package-dist/clean-generated.cjs --generated",
    "clean:all": "node ./scripts/package-dist/clean-generated.cjs --all",
    "clean": "pnpm clean:all && rm -rf dist .next",
    "lint": "pnpm lint:package && pnpm lint:todos && pnpm lint:workflows && pnpm lint:secrets && node ./scripts/validate-pricing.js && node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.mjs",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --ext .ts,.tsx,.mjs --fix",
    "lint:all": "pnpm lint && pnpm lint:deps",
    "lint:changelog": "node ./scripts/check-unreleased.js && node ./scripts/check-changelog.js",
    "lint:commits": "node ./node_modules/@commitlint/cli/cli.js --from HEAD~10 --to HEAD --verbose",
    "lint:deps": "node ./scripts/check-latest-deps.js",
    "lint:docs": "markdownlint --config .markdownlint.json \"docs/**/*.md\" \"project-logs/**/*.md\" \"project-prompts/**/*.md\" \"README.md\" \"CHANGELOG.md\" \"*.md\"",
    "lint:package": "node ./scripts/check-package-json.js",
    "lint:project-records": "node ./scripts/check-project-records.js",
    "lint:secrets": "node ./scripts/check-secret-leaks.js",
    "lint:todos": "node ./scripts/check-todo-management.js",
    "lint:workflows": "node ./scripts/check-github-workflows.js",
    "lint:workflows:fix": "node ./scripts/check-github-workflows.js --fix",
    "lint:workflows:refresh": "node ./scripts/check-github-workflows.js --refresh-golden",
    "link:docs": "node ./scripts/check-docs-links.js",
    "format": "prettier --write \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"project-logs/**/*.md\" \"project-prompts/**/*.md\" \"*.{json,md,mjs,ts}\" \".TODO/**/*.md\"",
    "format:check": "prettier --check \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"project-logs/**/*.md\" \"project-prompts/**/*.md\" \"*.{json,md,mjs,ts}\" \".TODO/**/*.md\"",
    "docs:check": "pnpm link:docs",
    "docs:lint": "pnpm lint:docs",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:ci": "pnpm audit --audit-level=moderate --json",
    "deps:check": "pnpm outdated",
    "health": "pnpm validate && pnpm test:all && pnpm docs:check && pnpm audit",
    "release:check": "pnpm validate && pnpm lint:changelog",
    "release:tag": "node ./scripts/release/tag.cjs",
    "release": "pnpm release:check && pnpm release:tag && pnpm prod:build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "payload:types": "node ./node_modules/payload/bin.js generate:types",
    "payload:migrate:create": "node ./node_modules/payload/bin.js migrate:create",
    "payload:migrate": "node ./node_modules/payload/bin.js migrate",
    "payload:migrate:status": "node ./node_modules/payload/bin.js migrate:status"
  },
