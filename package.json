{
  "name": "useclevr-2026",
  "version": "7.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=26.1.0",
    "pnpm": ">=11.1.2"
  },
  "homepage": "https://useclevr.com",
  "keywords": [
    "business-intelligence",
    "analytics",
    "csv",
    "ai",
    "nextjs"
  ],
  "scripts": {
    "dev": "AUTH_TRUST_HOST=true next dev --hostname 0.0.0.0 --port ${PORT:-3000}",
    "dev:all": "pnpm dev",
    "dev:server": "pnpm dev",
    "dev:frontend": "pnpm dev",
    "build": "next build --webpack",
    "build:next": "pnpm build",
    "build:clean": "pnpm clean:generated",
    "build:preview": "pnpm prod:build && pnpm start:dist",
    "start": "pnpm prod:start",
    "start:next": "next start --hostname 0.0.0.0 --port ${PORT:-8080}",
    "prod:install": "corepack enable && corepack prepare pnpm@11.1.2 --activate && pnpm install --frozen-lockfile",
    "prod:build": "NEXT_TELEMETRY_DISABLED=1 pnpm build && node ./scripts/dist/create-dist.cjs",
    "build:prod": "node ./scripts/dist/create-dist.cjs",
    "ci:railway": "node ./scripts/ci/sync-railway-config.cjs",
    "ci:fast": "CI=true pnpm validate:types && pnpm validate:dist",
    "ci:full": "CI=true pnpm validate && pnpm prod:build",
    "prod:start": "pnpm start:dist",
    "prod:local": "NEXT_TELEMETRY_DISABLED=1 AUTH_URL=http://localhost:8080 AUTH_SECRET=${AUTH_SECRET:-$NEXTAUTH_SECRET} AUTH_TRUST_HOST=true HOSTNAME=0.0.0.0 PORT=8080 node -r ./scripts/runtime/load-env.cjs dist/server.js",
    "prod": "pnpm prod:build && echo '✅ Dist is ready! Run \"pnpm start:dist\" to start the server.'",
    "start:dist": "NEXT_TELEMETRY_DISABLED=1 AUTH_URL=${AUTH_URL:-$NEXTAUTH_URL} AUTH_SECRET=${AUTH_SECRET:-$NEXTAUTH_SECRET} AUTH_TRUST_HOST=true HOSTNAME=${HOSTNAME:-0.0.0.0} PORT=${PORT:-8080} node -r ./scripts/runtime/load-env.cjs dist/server.js",
    "preview": "pnpm build:preview",
    "validate": "pnpm validate:types && pnpm validate:dist && pnpm validate:release",
    "validate:types": "tsc --noEmit --pretty false",
    "validate:build": "pnpm build",
    "validate:dist": "node ./scripts/ci/sync-railway-config.cjs --check",
    "validate:release": "node ./scripts/release/check.cjs",
    "analyze:business": "tsx scripts/analysis/analyze-business.ts",
    "test:all": "pnpm test:csv-analyzer",
    "test:csv-analyzer": "tsx scripts/analysis/test-csv-analyzer.ts",
    "test:neon": "bash scripts/health/test-neon-connection.sh",
    "test": "pnpm test:all",
    "clean:dev": "node ./scripts/build/clean-generated.cjs",
    "clean:prod": "node ./scripts/build/clean-generated.cjs --prod",
    "clean:generated": "node ./scripts/build/clean-generated.cjs --generated",
    "clean:all": "node ./scripts/build/clean-generated.cjs --all",
    "clean": "pnpm clean:all && rm -rf dist .next",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\"",
    "format:check": "prettier --check \"scripts/**/*.{js,cjs,mjs,ts,md}\" \"docs/**/*.md\" \"*.{json,md,mjs,ts}\"",
    "docs:check": "node ./scripts/docs/check-docs.cjs",
    "docs:lint": "markdownlint \"docs/**/*.md\"",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:ci": "pnpm audit --audit-level=moderate --json",
    "deps:check": "pnpm outdated",
    "health": "pnpm validate && pnpm test:all && pnpm docs:check && pnpm audit",
    "release:check": "pnpm validate",
    "release:tag": "node ./scripts/release/tag.cjs",
    "release": "pnpm release:check && pnpm release:tag && pnpm prod:build",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.65",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/papaparse": "^5.5.2",
    "ai": "^6.0.169",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.14.0",
    "next": "16.2.4",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.3",
    "pg": "^8.13.0",
    "postcss-import": "^16.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.5.0",
    "recharts": "^3.8.1",
    "stripe": "^14",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "10.5.0",
    "drizzle-kit": "^0.31.10",
    "markdownlint-cli": "^0.40.0",
    "postcss": "8.5.12",
    "prettier": "^3.8.3",
    "tailwindcss": "3.4.17",
    "tsx": "^4.21.0",
    "turbo": "^2.4.2",
    "typescript": "6.0.3"
  },
  "enginesStrict": true
}
