# Local development
# PORT controls `pnpm dev`; do not hardcode URLs in app code.
PORT=3000

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-generated-secret-min-32-chars-here
# Optional override only when host inference is not enough:
# AUTH_URL=http://localhost:${PORT}

# AI Provider
# Gemini is the active cloud AI provider.
GEMINI_API_KEY=AIza...                          # Get from https://aistudio.google.com/app/apikey

# Stripe (local dev — leave blank for trial mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                 # Set only if running the webhook locally
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Optional
