# Local development
# PORT controls `pnpm dev`; do not hardcode URLs in app code.
PORT=3000

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-generated-secret-min-32-chars-here
# Optional override only when host inference is not enough:
# AUTH_URL=http://localhost:${PORT}

# AI Provider
# Antigravity Proxy Server (local)
# Start the Antigravity CLI server: ./cli-proxy-api
# Server runs at http://127.0.0.1:8317 by default
ANTIGRAVITY_BASE_URL=http://127.0.0.1:8317        # Optional: defaults to 127.0.0.1:8317
ANTIGRAVITY_API_KEY=AIza...                       # API key from Antigravity config (can be same as GEMINI_API_KEY)

# Cloud AI (fallback when Antigravity/Local unavailable)
# Gemini is the active cloud AI provider.
GEMINI_API_KEY=AIza...                            # Get from https://aistudio.google.com/app/apikey

# BYOK AI Providers
# Generate with: openssl rand -base64 32
AI_PROVIDER_ENCRYPTION_KEY=your-generated-provider-key-min-32-bytes

# Stripe (local dev — leave blank for trial mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # Set only if running the webhook locally
USECLEVR_PRO_PRICE_EUR=price_...
USECLEVR_PRO_PRICE_GBP=price_...
USECLEVR_PRO_PRICE_USD=price_...
USECLEVR_PRO_PRICE_CAD=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_BUSINESS_PRICE_ID_EUR=price_...
STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# Business non-EUR markets stay unavailable until approved prices and matching Stripe Price IDs exist.
# STRIPE_BUSINESS_PRICE_ID_GBP=price_...
# STRIPE_BUSINESS_PRICE_ID_USD=price_...
# STRIPE_BUSINESS_PRICE_ID_CAD=price_...

# Square Retail POS integration (server-side only)
SQUARE_APPLICATION_ID=sandbox-sq0idb-...
SQUARE_APPLICATION_SECRET=sandbox-sq0csp-...
SQUARE_ENVIRONMENT=sandbox
SQUARE_REDIRECT_URI=http://localhost:3000/api/integrations/retail/square/callback
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/integrations/retail/square/webhooks
SQUARE_WEBHOOK_SIGNATURE_KEY=...
RETAIL_TOKEN_ENCRYPTION_KEY=your-generated-retail-token-key-min-32-chars

# Hosted test Square OAuth uses:
# NEXT_PUBLIC_APP_URL=https://test.useclevr.com
# SQUARE_REDIRECT_URI=https://test.useclevr.com/api/integrations/retail/square/callback

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Optional
