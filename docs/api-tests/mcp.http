@payloadMcpUrl = {{mcpUrl}}
@payloadMcpTestUrl = {{mcpTestUrl}}

### Payload MCP tools list without API key
# Expected: 401 Unauthorized without a valid Payload MCP API key
POST {{payloadMcpUrl}}/api/payload/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "1",
  "method": "tools/list",
  "params": {}
}

### Payload MCP tools list with API key
# Expected: 200 OK with JSON-RPC tool data
POST {{payloadMcpUrl}}/api/payload/mcp
Authorization: Bearer <paste-payload-mcp-api-key>
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "1",
  "method": "tools/list",
  "params": {}
}

### Payload MCP initialize
# Expected: 200 OK with JSON-RPC initialize response
POST {{payloadMcpUrl}}/api/payload/mcp
Authorization: Bearer <paste-payload-mcp-api-key>
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "2",
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "UseClevr REST Client",
      "version": "1.0.0"
    }
  }
}

### Payload MCP test connector tools list
# Expected: 200 OK with locked demo-account read tools
POST {{payloadMcpTestUrl}}/api/payload/mcp
Authorization: Bearer <paste-payload-mcp-test-api-key>
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "1",
  "method": "tools/list",
  "params": {}
}

### Payload MCP dashboard read tool invocation
# Expected: 200 OK with locked demo-account metadata and stored insights only
POST {{payloadMcpTestUrl}}/api/payload/mcp
Authorization: Bearer <paste-payload-mcp-test-api-key>
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "2",
  "method": "tools/call",
  "params": {
    "name": "listDashboardDatasets",
    "arguments": {}
  }
}
