@baseUrl = {{baseUrl}}

### MCP route reachability
# Expected: 401 Unauthorized without a signed-in session
GET {{baseUrl}}/api/mcp

### MCP tools list with signed-in session
# Expected: 200 OK with tools array
GET {{baseUrl}}/api/mcp
Cookie: authjs.session-token=<paste-local-session-cookie>

### MCP resources list for an owned dataset
# Expected: 200 OK with resource URIs for the owned dataset
GET {{baseUrl}}/api/mcp?datasetId=<paste-owned-dataset-id>
Cookie: authjs.session-token=<paste-local-session-cookie>

### MCP tool invocation for an owned dataset
# Expected: 200 OK with tool result
POST {{baseUrl}}/api/mcp
Content-Type: application/json
Cookie: authjs.session-token=<paste-local-session-cookie>

{
  "name": "getDatasetSchema",
  "input": {
    "datasetId": "<paste-owned-dataset-id>"
  }
}

### MCP tool invocation with service token
# Expected: 200 OK with tool result
POST {{baseUrl}}/api/mcp
Content-Type: application/json
x-mcp-service-token: <paste-service-token>

{
  "name": "getDatasetSchema",
  "input": {
    "datasetId": "<paste-owned-dataset-id>"
  }
}

### MCP admin token invocation
# Expected: 200 OK (admin scope allows compareDatasets)
POST {{baseUrl}}/api/mcp
Content-Type: application/json
x-mcp-admin-token: <paste-admin-token>

{
  "name": "compareDatasets",
  "input": {
    "datasetIdA": "<paste-dataset-id-a>",
    "datasetIdB": "<paste-dataset-id-b>"
  }
}

### Payload MCP tools list
# Expected: 200 OK with JSON-RPC tool data when the Payload MCP API key is valid
POST {{baseUrl}}/api/payload/mcp
Authorization: Bearer <paste-payload-mcp-api-key>
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": "1",
  "method": "tools/list",
  "params": {}
}
